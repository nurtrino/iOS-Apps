<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Dispatch</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Background fetch, so opening the app to a warm feed is the common case
	     rather than the lucky one. iOS decides when these run; the app only
	     asks. Without the mode declared the scheduled refresh is dropped on the
	     floor with no error anywhere. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nurtrino.dispatch.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>

	<!-- Every public source is plain HTTPS, so the default ATS policy stands for
	     the whole internet. The one carve-out is the local network: a
	     self-hosted RSSHub or Nitter bridge on the LAN is the arrangement that
	     actually keeps working, and those are almost always served over plain
	     http on a port.

	     `NSAllowsLocalNetworking` is the key that permits it. It relaxes
	     cleartext *only* for link-local and private addresses — .local names
	     and the RFC 1918 ranges — and leaves ATS fully in force for every
	     public host, which `NSAllowsArbitraryLoads` would not.

	     `NSLocalNetworkUsageDescription` is a different thing and does not
	     grant this: it is the privacy prompt for Bonjour and multicast
	     discovery. It is here because iOS 14+ requires it before an app may
	     contact local addresses at all. Both keys are needed; either one alone
	     leaves a LAN bridge failing. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Dispatch connects to an RSS bridge on your local network if you configure one for the X feeds. It contacts nothing else on your network.</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
